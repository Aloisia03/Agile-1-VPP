 </div>

 <!-- CARD THÔNG TIN -->
 <div class="card"
 style="background: white; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); overflow: hidden;">
 
 <table style="width: 100%; border-collapse: collapse;">
 <thead>
 <tr style="background: #f8f9fa;">
 <th style="padding: 15px; text-align: center;">Ảnh</th>
 <th style="padding: 15px;">Tên sản phẩm</th>
 <th style="padding: 15px;">Danh mục</th>
 <th style="padding: 15px;">Giá bán</th>
 <th style="padding: 15px;">Mô tả</th>
 </tr>
 </thead>

 <tbody>
 <tr>
 <!-- ẢNH -->
 <td style="padding: 15px; text-align: center;">
 <img src="<?php echo \htmlentities(file_url($product['image'] ?? 'uploads/no-image.png')??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 style="border-radius: 8px; object-fit: cover; width: 120px; height: 120px;" 
 alt="">
 </td>

 <!-- TÊN -->
 <td style="padding: 15px;">
 <strong style="color: #2c3e50;">
 <?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </strong>
 </td>

 <!-- DANH MỤC -->
 <td style="padding: 15px;">
 <?php echo \htmlentities($product['category_name']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </td>

 <!-- GIÁ -->
 <td style="padding: 15px;">
 <strong><?php echo \htmlentities($product['price']??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 </td>

 <!-- MÔ TẢ -->
 <td style="padding: 15px;">
 <span style="background: #e1f7ec; color: #27ae60; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: bold;">
 <?php echo \htmlentities($product['description']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 </td>
 </tr>
 </tbody>
 </table>
 </div>

 <!-- UPLOAD ẢNH -->
 <div class="upload-section" style="margin-top: 30px;">
 <h3>Cập nhật ảnh sản phẩm</h3>

 <form method="POST" 
 action="/Agile-1-VPP/product/upload-image/<?php echo \htmlentities($product['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 enctype="multipart/form-data"
 style="background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">

 <div style="margin-bottom: 15px;">
 <label style="display: block; margin-bottom: 5px; font-weight: bold;">
 Chọn ảnh:
 </label>

 <input type="file" name="image" accept="image/*"
 onchange="previewImage(event)"
 style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;">
 </div>

 <!-- PREVIEW -->
 <img id="preview" 
 src="#" 
 style="display:none; width:100px; margin-bottom:10px; border-radius:5px;">

 <button type="submit"
 style="background: #27ae60; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer;">
 <i class="fa fa-upload"></i> Upload ảnh
 </button>
 </form>
 </div>

 <!-- JS PREVIEW -->
 <script>
 function previewImage(event) {
 const img = document.getElementById('preview');
 img.src = URL.createObjectURL(event.target.files[0]);
 img.style.display = 'block';
 }
 </script>

 <style>
 tbody tr:hover {
 background-color: #fcfcfc;
 }

 tbody tr td {
 border-bottom: 1px solid #eee;
 }
 </style>
