<?php $_shouldextend[1]=1; ?>
<?php $this->startSection('content'); ?>
<div class="container-fluid py-4">
 <div class="d-flex justify-content-between align-items-center mb-4">
 <h4 class="font-weight-bold text-dark">Quản lý Kho hàng</h4>
 <span class="badge badge-info p-2">Tổng số mặt hàng: <?php echo \htmlentities(count($products)??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </div>

 <div class="card border-0 shadow-sm">
 <div class="table-responsive">
 <table class="table table-hover align-middle mb-0">
 <thead class="bg-light">
 <tr>
 <th class="border-0 pl-4">Sản phẩm</th>
 <th class="border-0">Danh mục</th>
 <th class="border-0 text-center">Giá bán</th>
 <th class="border-0 text-center">Tồn kho</th>
 <th class="border-0 text-center">Trạng thái</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $products; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $p): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td class="pl-4 font-weight-bold"><?php echo \htmlentities($p['name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($p['category_name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="text-center text-primary font-weight-bold"><?php echo \htmlentities(number_format($p['price'], 0, ',', '.')??'', ENT_QUOTES, 'UTF-8', false); ?> ₫</td>
 
 <td class="text-center align-middle" style="width: 200px;">
 <form action="/Agile-1-VPP/inventory/update" method="POST" class="d-flex justify-content-center m-0">
 <input type="hidden" name="product_id" value="<?php echo \htmlentities($p['id']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 
 <div class="input-group input-group-sm" style="width: 120px;">
 <input type="number" name="stock" value="<?php echo \htmlentities($p['stock']??'', ENT_QUOTES, 'UTF-8', false); ?>" class="form-control text-center font-weight-bold" min="0" required>
 <div class="input-group-append">
 <button type="submit" class="btn btn-success shadow-sm" data-toggle="tooltip" title="Lưu số lượng">
 <i class="fa-solid fa-floppy-disk"></i>
 </button>
 </div>
 </div>
 </form>
 </td>

 <td class="text-center">
 <?php if($p['stock'] <= 0): ?>
 <span class="badge badge-danger px-3 py-2">Hết hàng</span>
 <?php elseif($p['stock'] < 10): ?>
 <span class="badge badge-warning px-3 py-2 text-dark">Sắp hết</span>
 <?php else: ?>
 <span class="badge badge-success px-3 py-2">Còn hàng</span>
 <?php endif; ?>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild('home'); } ?>