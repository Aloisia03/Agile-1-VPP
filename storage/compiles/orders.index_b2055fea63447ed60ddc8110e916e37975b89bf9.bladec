<?php 
 // =========================
 // GET FILTER
 // =========================
 $currentStatus = $_GET['status'] ?? null;
 $orderId = $_GET['order_id'] ?? null;

 // =========================
 // DATA GỐC
 // =========================
 $baseOrders = $orders;

 // =========================
 // STATS (KHÔNG BỊ ẢNH HƯỞNG FILTER)
 // =========================
 $countAll = count($baseOrders);
 $countPending = count(array_filter($baseOrders, fn($o) => $o['status'] == 'pending'));
 $countConfirmed = count(array_filter($baseOrders, fn($o) => $o['status'] == 'confirmed'));
 $countCanceled = count(array_filter($baseOrders, fn($o) => $o['status'] == 'canceled'));

 // =========================
 // FILTER DATA HIỂN THỊ
 // =========================
 $ordersFiltered = $baseOrders;

 if (!empty($currentStatus)) {
 $ordersFiltered = array_filter($ordersFiltered, function ($o) use ($currentStatus) {
 return $o['status'] == $currentStatus;
 });
 }

 if (!empty($orderId)) {
 $ordersFiltered = array_filter($ordersFiltered, function ($o) use ($orderId) {
 return $o['id'] == $orderId;
 });
 }
 ?>

<!-- =========================
 STATS (CLICK FILTER)
========================= -->
<div class="row mb-4">

 <!-- TỔNG ĐƠN -->
 <div class="col-xl-3 col-md-6 mb-3">
 <a href="orders" class="text-decoration-none">
 <div class="card text-white bg-primary shadow-sm <?php echo \htmlentities(empty($currentStatus) ? 'border border-dark' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="card-body d-flex align-items-center">
 <i class="fa fa-shopping-cart fa-2x mr-3"></i>
 <div>
 <div>Tổng đơn</div>
 <h4 class="mb-0"><?php echo \htmlentities($countAll??'', ENT_QUOTES, 'UTF-8', false); ?></h4>
 </div>
 </div>
 </div>
 </a>
 </div>

 <!-- CHỜ DUYỆT -->
 <div class="col-xl-3 col-md-6 mb-3">
 <a href="?status=pending" class="text-decoration-none">
 <div class="card text-white bg-warning shadow-sm <?php echo \htmlentities($currentStatus == 'pending' ? 'border border-dark' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="card-body d-flex align-items-center">
 <i class="fa fa-clock fa-2x mr-3"></i>
 <div>
 <div>Chờ duyệt</div>
 <h4 class="mb-0"><?php echo \htmlentities($countPending??'', ENT_QUOTES, 'UTF-8', false); ?></h4>
 </div>
 </div>
 </div>
 </a>
 </div>

 <!-- ĐÃ DUYỆT -->
 <div class="col-xl-3 col-md-6 mb-3">
 <a href="?status=confirmed" class="text-decoration-none">
 <div class="card text-white bg-success shadow-sm <?php echo \htmlentities($currentStatus == 'confirmed' ? 'border border-dark' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="card-body d-flex align-items-center">
 <i class="fa fa-check fa-2x mr-3"></i>
 <div>
 <div>Đã duyệt</div>
 <h4 class="mb-0"><?php echo \htmlentities($countConfirmed??'', ENT_QUOTES, 'UTF-8', false); ?></h4>
 </div>
 </div>
 </div>
 </a>
