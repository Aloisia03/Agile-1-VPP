 <th>Tổng tiền</th>
 <th>Trạng thái</th>
 <th width="200">Hành động</th>
 </tr>
 </thead>

 <tbody>
 <?php $__empty_1 = true; foreach($ordersFiltered as $order): $__empty_1 = false; ?>
 <tr class="text-center">

 <td class="font-weight-bold text-muted">
 #<?php echo \htmlentities($order['id']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </td>

 <td class="text-left">
 <strong><?php echo \htmlentities($order['customer_name']??'', ENT_QUOTES, 'UTF-8', false); ?></strong><br>
 <small class="text-muted">
 <i class="fa fa-phone"></i>
 <?php echo \htmlentities($order['customer_phone'] ?? '---'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </small>
 </td>

 <td class="text-danger font-weight-bold">
 <?php echo \htmlentities(number_format($order['total_price'],0,',','.')??'', ENT_QUOTES, 'UTF-8', false); ?> ₫
 </td>

 <td>
 <?php if($order['status']=='pending'): ?>
 <span class="badge badge-warning">⏳ Chờ duyệt</span>
 <?php elseif($order['status']=='confirmed'): ?>
 <span class="badge badge-success">✔ Đã duyệt</span>
 <?php elseif($order['status']=='canceled'): ?>
 <span class="badge badge-danger">✖ Đã hủy</span>
 <?php endif; ?>
 </td>

 <td>
 <div class="d-flex justify-content-center">

 <a href="/Agile-1-VPP/orders/<?php echo \htmlentities($order['id']??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-sm btn-outline-primary mr-1">
 <i class="fa fa-eye"></i>
 </a>

 <?php if($order['status']=='pending'): ?>
 <form action="/Agile-1-VPP/orders/confirm/<?php echo \htmlentities($order['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST" class="mr-1">
 <button class="btn btn-sm btn-success"
 onclick="return confirm('Duyệt đơn này?')">
 <i class="fa fa-check"></i>
 </button>
 </form>
 <?php endif; ?>

 <?php if($order['status'] != 'canceled'): ?>
 <form action="/Agile-1-VPP/orders/cancel/<?php echo \htmlentities($order['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST">
 <button class="btn btn-sm btn-danger"
 onclick="return confirm('Hủy đơn này?')">
 <i class="fa fa-times"></i>
 </button>
 </form>
 <?php endif; ?>

 </div>
 </td>

 </tr>

 <?php endforeach; if ($__empty_1): ?>
 <tr>
 <td colspan="5" class="text-center py-5">
 <i class="fa fa-box-open fa-3x text-muted mb-3"></i>
 <p class="text-muted">Chưa có đơn hàng nào</p>
 </td>
 </tr>
 <?php endif; ?>
 </tbody>

 </table>
 </div>

