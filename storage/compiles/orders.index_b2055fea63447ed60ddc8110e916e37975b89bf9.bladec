<div class="container-fluid">

 <!-- HEADER -->
 <div class="d-flex justify-content-between align-items-center mb-4">
 <h4 class="font-weight-bold m-0">
 <i class="fa-solid fa-receipt text-primary mr-2"></i> Quản lý đơn hàng
 </h4>
