 <!-- ĐÃ HỦY -->
 <div class="col-xl-3 col-md-6 mb-3">
 <a href="?status=canceled" class="text-decoration-none">
 <div class="card text-white bg-danger shadow-sm <?php echo \htmlentities($currentStatus == 'canceled' ? 'border border-dark' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="card-body d-flex align-items-center">
 <i class="fa fa-times fa-2x mr-3"></i>
 <div>
