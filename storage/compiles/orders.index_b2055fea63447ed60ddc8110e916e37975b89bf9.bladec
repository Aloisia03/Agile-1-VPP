 <input type="text"
 name="order_id"
 class="form-control mr-2"
 placeholder="🔍 Tìm Mã Đơn"
 value="<?php echo $_GET['order_id'] ?? ''; ?>">

 <button class="btn btn-primary">Tìm</button>

 <?php if (!empty($_GET['order_id']) || !empty($_GET['status'])): ?>
 <a href="orders" class="btn btn-outline-secondary ml-2">Reset</a>
