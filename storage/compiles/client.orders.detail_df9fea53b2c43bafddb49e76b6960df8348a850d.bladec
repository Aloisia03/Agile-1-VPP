 </div>
 <div class="table-responsive">
 <table class="table table-hover mb-0 align-middle text-center">
 <thead class="bg-light text-dark">
 <tr>
 <th class="py-3 text-left pl-4">Sản phẩm</th>
 <th class="py-3">Đơn giá</th>
 <th class="py-3">Số lượng</th>
 <th class="py-3">Thành tiền</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $orderDetails; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $item): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td class="text-left pl-4 d-flex align-items-center">
 <img src="/Agile-1-VPP/public/uploads/<?php echo \htmlentities($item['image']??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($item['name']??'', ENT_QUOTES, 'UTF-8', false); ?>" class="rounded mr-3 border" style="width: 50px; height: 50px; object-fit: cover;">
 <span class="font-weight-bold text-dark"><?php echo \htmlentities($item['name']??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </td>
 <td class="text-muted"><?php echo \htmlentities(number_format($item['price'], 0, ',', '.')??'', ENT_QUOTES, 'UTF-8', false); ?> ₫</td>
 <td><span class="badge badge-light border px-2 py-1"><?php echo \htmlentities($item['quantity']??'', ENT_QUOTES, 'UTF-8', false); ?></span></td>
 <td class="font-weight-bold text-danger">
 <?php echo \htmlentities(number_format($item['price'] * $item['quantity'], 0, ',', '.')??'', ENT_QUOTES, 'UTF-8', false); ?> ₫
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
 </div>
 <div class="card-footer bg-white text-right py-4 pr-4">
 <h5 class="mb-0">
 <span class="text-muted mr-3">Tổng cộng:</span> 
 <span class="font-weight-bold text-danger" style="font-size: 1.5rem;">
 <?php echo \htmlentities(number_format($order['total_price'] ?? $order['total'] ?? 0, 0, ',', '.')??'', ENT_QUOTES, 'UTF-8', false); ?> ₫
 </span>
 </h5>
 </div>
 </div>
 </div>
 </div>
</div>
