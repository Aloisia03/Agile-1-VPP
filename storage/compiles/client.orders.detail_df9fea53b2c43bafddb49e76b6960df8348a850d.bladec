 </div>
 <div class="card-body">
 <p class="mb-2"><strong>Mã đơn hàng:</strong> <span class="text-danger">#<?php echo \htmlentities($order['id']??'', ENT_QUOTES, 'UTF-8', false); ?></span></p>
 <p class="mb-2"><strong>Trạng thái:</strong> 
 <?php if($order['status'] == 'pending' || $order['status'] == 'Chờ xác nhận'): ?>
 <span class="badge badge-warning px-2 py-1 text-white">Chờ xác nhận</span>
 <?php elseif($order['status'] == 'Đang giao'): ?>
 <span class="badge badge-info px-2 py-1">Đang giao</span>
 <?php elseif($order['status'] == 'Hoàn thành'): ?>
 <span class="badge badge-success px-2 py-1">Hoàn thành</span>
 <?php elseif($order['status'] == 'Đã hủy'): ?>
 <span class="badge badge-secondary px-2 py-1">Đã hủy</span>
 <?php else: ?>
 <span class="badge badge-dark px-2 py-1"><?php echo \htmlentities($order['status']??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 <?php endif; ?>
 </p>
 <hr>
 <h6 class="font-weight-bold mb-3">Thông tin người nhận</h6>
 <p class="mb-1"><i class="fa-solid fa-user text-muted mr-2"></i> <?php echo \htmlentities($order['customer_name']??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 <p class="mb-1"><i class="fa-solid fa-phone text-muted mr-2"></i> <?php echo \htmlentities($order['customer_phone']??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 <p class="mb-1"><i class="fa-solid fa-location-dot text-muted mr-2"></i> <?php echo \htmlentities($order['customer_address']??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 
 <?php if(!empty($order['note'])): ?>
 <div class="alert alert-warning mt-3 mb-0 p-2 text-sm">
 <strong>Ghi chú:</strong> <?php echo \htmlentities($order['note']??'', ENT_QUOTES, 'UTF-8', false); ?>

