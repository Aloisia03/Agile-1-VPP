 <input type="number" 
 name="quantity" 
 value="<?php echo \htmlentities($item['quantity']??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 min="1" 
 class="qty-input">

 <button class="btn btn-primary btn-sm">
 Cập nhật
 </button>
 </form>
 </td>

 <td class="subtotal">
 <?php echo \htmlentities(number_format($item['subtotal'])??'', ENT_QUOTES, 'UTF-8', false); ?>đ
 </td>

 <td>
 <form method="POST" action="/Agile-1-VPP/cart/update">
 <input type="hidden" name="product_id" value="<?php echo \htmlentities($item['id']??'', ENT_QUOTES, 'UTF-8', false); ?>">
