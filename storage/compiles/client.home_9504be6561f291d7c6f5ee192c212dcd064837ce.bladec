<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $title); ?>

<?php $this->startSection('content'); ?>
<div class="container py-4">
 <div class="jumbotron jumbotron-fluid bg-info text-white rounded shadow-sm text-center">
 <div class="container">
 <h1 class="display-4 font-weight-bold">Mùa tựu trường rộn ràng!</h1>
 <p class="lead">Sắm dụng cụ học tập xịn - Đón điểm 10 lung linh.</p>
 </div>
 </div>

 <h3 class="mb-4 font-weight-bold border-bottom pb-2">Sản phẩm nổi bật</h3>
 
 <div class="row">
 <?php if(!empty($products)): ?>
 <?php $__currentLoopData = array_slice($products, 0, 4); $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $product): $loop = $this->incrementLoopIndices();  ?> <?php /* Chỉ hiện 4 cái */ ?>
 <div class="col-md-3 mb-4">
 <div class="card h-100 shadow-sm border-0">
 <img src="/Agile-1-VPP/public/uploads/<?php echo \htmlentities($product['image']??'', ENT_QUOTES, 'UTF-8', false); ?>" class="card-img-top" alt="<?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?>" style="height: 200px; object-fit: cover;">
 <div class="card-body text-center">
 <h6 class="card-title text-dark"><?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?></h6>
 <p class="card-text text-danger font-weight-bold"><?php echo \htmlentities(number_format($product['price'])??'', ENT_QUOTES, 'UTF-8', false); ?>đ</p>
 <a href="/Agile-1-VPP/product/<?php echo \htmlentities($product['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-outline-info btn-sm">Xem chi tiết</a>
 </div>
 </div>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </div>
</div>
<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.client'); } ?>