 .home-page-luxury { font-family: 'Montserrat', sans-serif; color: #333; }

 /* 1. HERO BANNER PREMIUM */
 .hero-banner-premium {
 height: 500px; /* Chiều cao cố định */
 background-color: #f8f9fa;
