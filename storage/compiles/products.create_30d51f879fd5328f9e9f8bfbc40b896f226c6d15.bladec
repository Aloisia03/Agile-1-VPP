<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('content'); ?>
 <?php if(isset($_SESSION['flash']['error'])): ?>
 <div class="alert alert-danger">
 <?php echo \htmlentities($_SESSION['flash']['error']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </div>

 <?php 
 unset($_SESSION['flash']);
 ?>
 <?php endif; ?>

 <div class="card">
 <h2 class="card-header">Thêm sản phẩm</h2>
 <div class="card-body">
 <form action="<?php echo \htmlentities(route('/product/store')??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST" enctype="multipart/form-data">
 <div class="mb-3">
 <label class="label" for="">Tên sản phẩm</label>
 <input type="text" name="name" class="form-control" placeholder="Nhập tên sản phẩm">
 </div>
 <div class="mb-3">
 <label class="label" for="">Danh mục</label>
 <select name="category_id" id="" class="form-select">
 <option value="" disabled>---Chọn danh mục---</option>
 <?php $__currentLoopData = $categories; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $category): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($category['id']??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($category['name']??'', ENT_QUOTES, 'UTF-8', false); ?></option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>

 <div class="mb-3">
 <label class="label" for="">Giá sản phẩm</label>
 <input type="text" name="price" class="form-control" placeholder="Nhập giá sản phẩm">
 </div>

 <div class="mb-3">
 <label class="label" for="">Mô tả</label>
 <textarea name="description" class="form-control" placeholder="Nhập mô tả sản phẩm"></textarea>
 </div>
 <div class="mb-3">
 <label class="label" for="">Hình ảnh</label>
 <input type="file" name="image" class="form-control">
 </div>

 <div class="mb-3">
 <button type="submit" class="btn btn-success">Thêm</button>
 <a href="<?php echo \htmlentities(route('/products')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn btn-secondary">Quay lại</a>
 </div>


 </form>
 </div>
 </div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('home'); } ?>