 <th style="padding: 15px; text-align: center;">Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $products; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $product): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td style="padding: 15px; text-align: center;">
 <img src="<?php echo \htmlentities(file_url($product['image'] ?? '')??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 style="border-radius: 5px; object-fit: cover; width: 60px; height: 60px;" 
 alt="">
</td>
 <td style="padding: 15px;">
 <strong style="color: #2c3e50;"><?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?></strong><br>
 </td>
 <td style="padding: 15px;"><?php echo \htmlentities($product['category_name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td style="padding: 15px;"><strong><?php echo \htmlentities($product['price']??'', ENT_QUOTES, 'UTF-8', false); ?></strong></td>
 <td style="padding: 15px;">
 <span
 style="background: #e1f7ec; color: #27ae60; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: bold;">
 <?php echo \htmlentities($product['description']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 </td>

 <td style="padding: 15px; text-align: center;">

 <!-- Chi tiết -->
 <a href="<?php echo \htmlentities(route('/product/show/' . $product['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>"
 style="color: #3498db; margin-right: 10px;" title="chi tiết">
 Chi tiết
 </a>

 <!-- 🛒 THÊM GIỎ HÀNG -->
 <form method="POST" action="/Agile-1-VPP/cart/add" style="display:inline;">
 <input type="hidden" name="product_id" value="<?php echo \htmlentities($product['id']??'', ENT_QUOTES, 'UTF-8', false); ?>">
