<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Tất cả sản phẩm'); ?>

<?php $this->startSection('content'); ?>
<div class="container py-4">

 <!-- BREADCRUMB -->
 <nav aria-label="breadcrumb">
 <ol class="breadcrumb bg-transparent px-0 pb-2 border-bottom">
 <li class="breadcrumb-item">
 <a href="/Agile-1-VPP/client/home" class="text-info">Trang chủ</a>
 </li>
 <li class="breadcrumb-item active">Sản phẩm</li>
 </ol>
 </nav>

 <!-- FILTER + SEARCH -->
 <form method="GET" class="mb-4">

 <div class="row align-items-end">

 <!-- SEARCH -->
 <div class="col-md-4 mb-2">
 <label class="font-weight-bold">Tìm sản phẩm</label>
 <input type="text"
 name="keyword"
 class="form-control"
 placeholder="Nhập tên sản phẩm..."
 value="<?= $_GET['keyword'] ?? '' ?>">
 </div>

 <!-- CATEGORY -->
 <div class="col-md-3 mb-2">
 <label class="font-weight-bold">Danh mục</label>
 <select name="category_id" class="form-control">

 <option value="">Tất cả danh mục</option>

 <?php $__currentLoopData = $categories; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $cate): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($cate['id']??'', ENT_QUOTES, 'UTF-8', false); ?>"
 <?php echo \htmlentities((isset($_GET['category_id']) && $_GET['category_id'] == $cate['id']) ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 <?php echo \htmlentities($cate['name']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>

 </select>
 </div>

 <!-- SORT -->
 <div class="col-md-3 mb-2">
 <label class="font-weight-bold">Sắp xếp giá</label>
 <select name="sort" class="form-control">

 <option value="">Mặc định</option>

 <option value="asc"
 <?php echo \htmlentities((isset($_GET['sort']) && $_GET['sort']=='asc') ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 Tăng dần
 </option>

 <option value="desc"
 <?php echo \htmlentities((isset($_GET['sort']) && $_GET['sort']=='desc') ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 Giảm dần
 </option>

 </select>
 </div>

 <!-- BUTTON -->
 <div class="col-md-2 mb-2">
 <button class="btn btn-info btn-block font-weight-bold">
 Lọc
 </button>
 </div>

 </div>

 </form>

 <!-- ACTIVE FILTER DISPLAY -->
 <?php if(!empty($_GET['keyword']) || !empty($_GET['category_id']) || !empty($_GET['sort'])): ?>
 <div class="mb-3">
 <span class="badge badge-info p-2">
 Đang áp dụng bộ lọc
 </span>
 </div>
 <?php endif; ?>

 <!-- PRODUCT LIST -->
 <div class="row">

 <?php $__empty_1 = true; foreach($products as $product): $__empty_1 = false; ?>

 <div class="col-lg-3 col-md-4 col-sm-6 mb-4">

 <div class="card product-card border-0 shadow-sm h-100">

 <!-- IMAGE -->
 <div class="product-img">
 <img
 src="<?php echo \htmlentities(file_url($product['image'] ?? '')??'', ENT_QUOTES, 'UTF-8', false); ?>"
 onerror="this.src='https://via.placeholder.com/300x250?text=No+Image'"
 alt="<?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>

 <!-- BODY -->
 <div class="card-body text-center d-flex flex-column">

 <h6 class="product-name">
 <?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </h6>

 <div class="product-price">
 <?php echo \htmlentities(number_format($product['price'], 0, ',', '.')??'', ENT_QUOTES, 'UTF-8', false); ?> ₫
 </div>

 <div class="mt-auto">
 <a href="/Agile-1-VPP/client/product/<?php echo \htmlentities($product['id']??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-outline-info btn-sm w-100 rounded-pill">
 <i class="fa-solid fa-eye"></i> Xem chi tiết
 </a>
 </div>

 </div>

 </div>

 </div>

 <?php endforeach; if ($__empty_1): ?>

 <div class="col-12 text-center py-5 bg-white shadow-sm rounded">
 <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
 <p class="text-muted lead">Không tìm thấy sản phẩm phù hợp</p>
 </div>

 <?php endif; ?>

 </div>

</div>
<?php $this->stopSection(); ?>

<?php $this->startPush('styles'); ?>
<style>

.product-card {
 border-radius: 14px;
 transition: 0.3s;
}

.product-card:hover {
 transform: translateY(-6px);
 box-shadow: 0 15px 30px rgba(0,0,0,0.15);
}

.product-img {
 height: 220px;
 display: flex;
 align-items: center;
 justify-content: center;
 overflow: hidden;
}

.product-img img {
 width: 100%;
 height: 100%;
 object-fit: contain;
 transition: 0.3s;
}

.product-card:hover img {
 transform: scale(1.05);
}

.product-name {
 font-weight: 600;
 color: #2c3e50;
 height: 40px;
 overflow: hidden;
}

.product-price {
 color: #e74c3c;
 font-weight: bold;
 font-size: 1.1rem;
 margin-bottom: 10px;
}

.btn-outline-info:hover {
 background: #17a2b8;
 color: #fff;
}

</style>
<?php $this->stopPush(); ?>
