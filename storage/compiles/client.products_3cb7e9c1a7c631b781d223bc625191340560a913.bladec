<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $title); ?>

<?php $this->startSection('content'); ?>
<div class="container py-4">
 <h3 class="mb-4 font-weight-bold text-center">Tất cả sản phẩm</h3>
 
 <div class="row">
 <?php if(!empty($products)): ?>
 <?php $__currentLoopData = $products; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $product): $loop = $this->incrementLoopIndices();  ?>
 <div class="col-md-3 col-sm-6 mb-4">
 <div class="card h-100 shadow-sm border-0">
 <img src="/Agile-1-VPP/public/uploads/<?php echo \htmlentities($product['image']??'', ENT_QUOTES, 'UTF-8', false); ?>" class="card-img-top" alt="<?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?>" style="height: 200px; object-fit: cover;">
 <div class="card-body d-flex flex-column">
 <h6 class="card-title text-dark"><?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?></h6>
 <p class="text-muted small"><?php echo \htmlentities($product['category_name'] ?? 'Văn phòng phẩm'??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 <h5 class="text-danger font-weight-bold mt-auto mb-3"><?php echo \htmlentities(number_format($product['price'])??'', ENT_QUOTES, 'UTF-8', false); ?>đ</h5>
 
 <form action="/Agile-1-VPP/checkout" method="POST" class="w-100 mt-auto">
 <input type="hidden" name="product_id" value="<?php echo \htmlentities($product['id']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <input type="hidden" name="quantity" value="1">
 <button type="submit" class="btn btn-primary btn-block"><i class="fa-solid fa-cart-plus"></i> Mua ngay</button>
 </form>
 </div>
 </div>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php else: ?>
 <div class="col-12 text-center text-muted py-5">Chưa có sản phẩm nào.</div>
 <?php endif; ?>
 </div>
</div>
<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.client'); } ?>