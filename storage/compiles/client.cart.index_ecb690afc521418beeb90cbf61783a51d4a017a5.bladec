<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Giỏ hàng của bạn'); ?>

<?php $this->startSection('content'); ?>
<div class="container py-4">
 <h3 class="font-weight-bold mb-4 text-info"><i class="fa-solid fa-cart-shopping mr-2"></i> Giỏ hàng của bạn</h3>

 <?php if(!empty($cart)): ?>
 <div class="row">
 <div class="col-lg-8 mb-4">
 <div class="card shadow-sm border-0 rounded-lg">
 <div class="table-responsive">
 <table class="table table-hover mb-0 text-center align-middle">
 <thead class="bg-light text-dark">
 <tr>
 <th class="py-3">Sản phẩm</th>
 <th class="py-3">Đơn giá</th>
 <th class="py-3">Số lượng</th>
 <th class="py-3">Thành tiền</th>
 <th class="py-3">Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php $totalPrice = 0;  ?>
 <?php $__currentLoopData = $cart; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $id => $item): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $subtotal = $item['price'] * $item['quantity'];
 $totalPrice += $subtotal;
 ?>
 <tr>
 <td class="text-left d-flex align-items-center">
 <img src="/Agile-1-VPP/public/uploads/<?php echo \htmlentities($item['image']??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($item['name']??'', ENT_QUOTES, 'UTF-8', false); ?>" class="rounded mr-3" style="width: 60px; height: 60px; object-fit: cover;">
 <span class="font-weight-bold"><?php echo \htmlentities($item['name']??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </td>
 <td class="align-middle text-danger"><?php echo \htmlentities(number_format($item['price'], 0, ',', '.')??'', ENT_QUOTES, 'UTF-8', false); ?> ₫</td>
 <td class="align-middle">
 <span class="badge badge-info px-3 py-2" style="font-size: 1rem;"><?php echo \htmlentities($item['quantity']??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </td>
 <td class="align-middle font-weight-bold text-danger"><?php echo \htmlentities(number_format($subtotal, 0, ',', '.')??'', ENT_QUOTES, 'UTF-8', false); ?> ₫</td>
 <td class="align-middle">
 <a href="/Agile-1-VPP/client/cart/remove/<?php echo \htmlentities($id??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-outline-danger btn-sm rounded-circle" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
 <i class="fa-solid fa-trash-can"></i>
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
 </div>
 </div>
 </div>

 <div class="col-lg-4">
 <div class="card shadow-sm border-0 rounded-lg p-4">
 <h5 class="font-weight-bold mb-3 border-bottom pb-2">Tổng quan đơn hàng</h5>
 <div class="d-flex justify-content-between mb-3">
 <span class="text-muted">Tổng tạm tính:</span>
 <span class="font-weight-bold"><?php echo \htmlentities(number_format($totalPrice, 0, ',', '.')??'', ENT_QUOTES, 'UTF-8', false); ?> ₫</span>
 </div>
 <div class="d-flex justify-content-between mb-4">
 <span class="text-muted">Phí giao hàng:</span>
 <span class="text-success font-weight-bold">Miễn phí</span>
 </div>
 <div class="d-flex justify-content-between mb-4 border-top pt-3">
 <h5 class="font-weight-bold">Tổng cộng:</h5>
 <h4 class="font-weight-bold text-danger m-0"><?php echo \htmlentities(number_format($totalPrice, 0, ',', '.')??'', ENT_QUOTES, 'UTF-8', false); ?> ₫</h4>
 </div>
 
 <a href="/Agile-1-VPP/client/checkout" class="btn btn-info btn-block py-3 font-weight-bold text-uppercase rounded-pill shadow-sm">
 Tiến hành đặt hàng <i class="fa-solid fa-arrow-right ml-1"></i>
 </a>
 <a href="/Agile-1-VPP/client/products" class="btn btn-link btn-block text-muted text-decoration-none mt-2">
 <i class="fa-solid fa-arrow-left mr-1"></i> Tiếp tục mua sắm
 </a>
 </div>
 </div>
 </div>
 <?php else: ?>
 <div class="text-center py-5 bg-white shadow-sm rounded-lg">
 <img src="https://cdn-icons-png.flaticon.com/512/11329/11329060.png" alt="Empty Cart" style="width: 150px; opacity: 0.5;" class="mb-4">
 <h4 class="text-muted mb-3">Giỏ hàng của bạn đang trống!</h4>
 <a href="/Agile-1-VPP/client/products" class="btn btn-info px-4 py-2 font-weight-bold rounded-pill">Về trang sản phẩm ngay</a>
 </div>
 <?php endif; ?>
</div>
<?php $this->stopSection(); ?>
