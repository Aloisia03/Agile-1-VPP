 <th>Số lượng</th>
 <th>Thành tiền</th>
 <th>Thao tác</th>
 </tr>
 </thead>

 <tbody>

 <?php $totalPrice = 0;  ?>

 <?php $__currentLoopData = $cart; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $id => $item): $loop = $this->incrementLoopIndices();  ?>

 <?php 
 $subtotal = $item['price'] * $item['quantity'];
 $totalPrice += $subtotal;
 ?>

 <tr class="border-bottom">

 <!-- PRODUCT -->
 <td class="text-left d-flex align-items-center gap-2">

 <img
 src="<?php echo \htmlentities(file_url($item['image'] ?? '')??'', ENT_QUOTES, 'UTF-8', false); ?>"
 onerror="this.src='https://via.placeholder.com/80x80?text=No+Image'"
 style="width:60px;height:60px;object-fit:cover;border-radius:10px;"
 >

 <div class="ml-2">
 <div class="font-weight-bold">
 <?php echo \htmlentities($item['name']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </div>
 </div>

 </td>

 <!-- PRICE -->
 <td class="text-danger font-weight-bold">
 <?php echo \htmlentities(number_format($item['price'],0,',','.')??'', ENT_QUOTES, 'UTF-8', false); ?> ₫
 </td>

 <!-- QUANTITY -->
 <td>

 <form method="POST"
 action="/Agile-1-VPP/client/cart/update"
 class="d-flex justify-content-center align-items-center">

 <input type="hidden" name="id" value="<?php echo \htmlentities($id??'', ENT_QUOTES, 'UTF-8', false); ?>">

 <input type="number"
 name="quantity"
 value="<?php echo \htmlentities($item['quantity']??'', ENT_QUOTES, 'UTF-8', false); ?>"
 min="1"
 class="form-control form-control-sm text-center"
 style="width:70px;border-radius:8px;">

 <button type="submit"
 class="btn btn-sm btn-primary ml-2 rounded-circle"
 title="Cập nhật">
 <i class="fa fa-sync"></i>
 </button>

 </form>

 </td>

 <!-- SUBTOTAL -->
 <td class="text-danger font-weight-bold">
 <?php echo \htmlentities(number_format($subtotal,0,',','.')??'', ENT_QUOTES, 'UTF-8', false); ?> ₫
 </td>

 <!-- REMOVE -->
 <td>
 <a href="/Agile-1-VPP/client/cart/remove/<?php echo \htmlentities($id??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-sm btn-outline-danger rounded-circle"
 onclick="return confirm('Xóa sản phẩm này?');">
 <i class="fa fa-trash"></i>
 </a>
 </td>

 </tr>

 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>

 </tbody>

 </table>

 </div>

 </div>

 </div>

 <!-- SUMMARY -->
 <div class="col-lg-4">

 <div class="card shadow-sm border-0 rounded-lg p-4 sticky-top" style="top:20px;">

