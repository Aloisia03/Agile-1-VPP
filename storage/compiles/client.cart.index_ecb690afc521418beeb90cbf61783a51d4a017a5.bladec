 <?php if(!empty($cart)): ?>

 <div class="row">

 <!-- CART TABLE -->
 <div class="col-lg-8 mb-4">

 <div class="card shadow-sm border-0 rounded-lg overflow-hidden">

 <div class="table-responsive">

 <table class="table align-middle text-center mb-0">

 <thead class="bg-info text-white">
