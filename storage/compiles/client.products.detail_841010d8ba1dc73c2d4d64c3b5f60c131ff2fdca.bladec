 </li>
 <li class="breadcrumb-item active"><?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?></li>
 </ol>
 </nav>

 <?php /* CARD */ ?>
 <div class="card border-0 shadow-sm rounded-lg mt-3">
 <div class="row no-gutters">

 <?php /* IMAGE */ ?>
 <div class="col-md-5 product-img-wrap">
 <img src="<?php echo \htmlentities(file_url($product['image'] ?? '')??'', ENT_QUOTES, 'UTF-8', false); ?>"
 onerror="this.src='https://via.placeholder.com/400x400'"
 alt="<?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>

 <?php /* INFO */ ?>
 <div class="col-md-7 p-5 bg-light">

 <h2 class="font-weight-bold mb-2"><?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?></h2>

 <p class="text-muted mb-3">
 Mã SP: #<?php echo \htmlentities($product['id']??'', ENT_QUOTES, 'UTF-8', false); ?> |
 <span class="badge badge-success">Còn hàng</span>
 </p>

 <input type="hidden" id="base_price" value="<?php echo \htmlentities($product['price']??'', ENT_QUOTES, 'UTF-8', false); ?>">

 <?php /* PRICE */ ?>
 <div class="price-box mb-4">
 <h3 id="display_price">
 <?php echo \htmlentities(number_format($product['price'], 0, ',', '.')??'', ENT_QUOTES, 'UTF-8', false); ?> ₫
 </h3>
 </div>

 <?php /* DESCRIPTION */ ?>
 <p class="mb-4 text-muted">
 <?php echo \htmlentities($product['description'] ?? 'Đang cập nhật mô tả...'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </p>

 <?php /* FORM */ ?>
 <form action="/Agile-1-VPP/client/cart/add" method="POST">
 <input type="hidden" name="product_id" value="<?php echo \htmlentities($product['id']??'', ENT_QUOTES, 'UTF-8', false); ?>">

 <?php /* QUANTITY */ ?>
 <div class="d-flex align-items-center mb-4">
 <strong class="mr-3">Số lượng:</strong>

 <div class="qty-box">
 <button type="button" onclick="changeQty(-1)">-</button>
 <input type="number" id="qty" name="quantity" value="1" min="1" readonly>
 <button type="button" onclick="changeQty(1)">+</button>
 </div>
 </div>

 <?php /* BUTTON */ ?>
 <div class="row">
 <div class="col-sm-6 mb-3">
 <button class="btn btn-outline-info btn-block py-3 font-weight-bold">
 <i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ
 </button>
 </div>

