<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('content'); ?>
<div class="container-fluid py-4" style="background-color: #f8f9fc; min-height: 100vh;">
 
 <div class="d-flex justify-content-between align-items-center mb-4">
 <h4 class="font-weight-bold text-dark">Quản lý Khách hàng</h4>
 <div class="text-muted font-weight-bold">Tổng số: <?php echo \htmlentities(count($users)??'', ENT_QUOTES, 'UTF-8', false); ?> tài khoản</div>
 </div>

 <div class="card border-0 shadow-sm rounded-lg">
 <div class="table-responsive">
 <table class="table table-hover align-middle mb-0">
 <thead class="bg-light">
 <tr>
 <th class="border-0 pl-4">Khách hàng</th>
 <th class="border-0">Liên hệ</th>
 <th class="border-0 text-center">Đơn hàng</th>
 <th class="border-0 text-right">Đã chi tiêu</th>
 <th class="border-0 text-center">Trạng thái</th>
 <th class="border-0 text-center pr-4">Thao tác</th>
 <th class="border-0 text-center pr-4">Quyền điều hành</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $users; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $user): $loop = $this->incrementLoopIndices();  ?>
 <tr style="<?php echo \htmlentities($user['status'] == 'banned' ? 'opacity: 0.6; background: #fdfdfe;' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <td class="pl-4 align-middle">
 <div class="d-flex align-items-center">
 <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mr-3" style="width: 35px; height: 35px; font-size: 0.8rem;">
 <?php echo \htmlentities(strtoupper(substr($user['name'], 0, 1))??'', ENT_QUOTES, 'UTF-8', false); ?>

 </div>
 <div>
 <div class="font-weight-bold"><?php echo \htmlentities($user['name']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <small class="text-muted">ID: #<?php echo \htmlentities($user['id']??'', ENT_QUOTES, 'UTF-8', false); ?></small>
 </div>
 </div>
 </td>
 <td class="align-middle">
 <div class="small text-dark"><?php echo \htmlentities($user['email']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div class="small text-muted"><?php echo \htmlentities($user['phone'] ?? 'Chưa có SĐT'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </td>
 <td class="text-center align-middle font-weight-bold text-primary">
 <?php echo \htmlentities($user['total_orders']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </td>
 <td class="text-right align-middle font-weight-bold text-success">
 <?php echo \htmlentities(number_format($user['total_spent'], 0, ',', '.')??'', ENT_QUOTES, 'UTF-8', false); ?> ₫
 </td>
 <td class="text-center align-middle">
 <?php if($user['status'] == 'active'): ?>
 <span class="badge badge-pill badge-success px-3 py-1">Hoạt động</span>
 <?php else: ?>
 <span class="badge badge-pill badge-danger px-3 py-1">Bị khóa</span>
 <?php endif; ?>
 </td>
 <td class="text-center align-middle pr-4">
 <form action="/Agile-1-VPP/users/toggle-status/<?php echo \htmlentities($user['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST" class="m-0">
 <?php if($user['status'] == 'active'): ?>
 <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Khóa tài khoản này?')">
 <i class="fa-solid fa-user-slash mr-1"></i> Khóa
 </button>
 <?php else: ?>
 <button class="btn btn-sm btn-success" onclick="return confirm('Mở lại tài khoản?')">
 <i class="fa-solid fa-user-check mr-1"></i> Mở khóa
 </button>
 <?php endif; ?>
 </form>
 </td>
 <td class="align-middle text-center">
 <form action="/Agile-1-VPP/users/update-role/<?php echo \htmlentities($user['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST" class="m-0">
 <select name="role" class="form-control form-control-sm font-weight-bold" 
 onchange="this.form.submit()"
 style="border-radius: 20px; <?php echo \htmlentities($user['role'] == 'admin' ? 'color: #e74a3b; border-color: #e74a3b;' : 'color: #4e73df; border-color: #4e73df;'??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <option value="customer" <?php echo \htmlentities($user['role'] == 'customer' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Khách hàng</option>
 <option value="staff" <?php echo \htmlentities($user['role'] == 'staff' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Nhân viên</option>
 <option value="admin" <?php echo \htmlentities($user['role'] == 'admin' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Quản trị viên</option>
 </select>
 </form>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild('home'); } ?>